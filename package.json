{
  "name": "courtside-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "package:github": "node scripts/package-github.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
