{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "jsx": "react-jsx", "strict": true,
    "noEmit": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src", "shared", "server", "tests", "vite.config.ts"]
}
